# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL, from Supabase dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=

# Anon (public) key. Safe to expose to the browser; RLS restricts what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. SERVER-ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_,
# never import the module that uses this into a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Telegram
# ---------------------------------------------------------------------------
# Bot token from @BotFather. SERVER-ONLY, used to validate initData / Login Widget
# payloads and never sent to the client.
TELEGRAM_BOT_TOKEN=

# Bot username without the leading @ (e.g. "tp_spain_bot"). Public: used to render
# the Telegram Login Widget and to build t.me deep links.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Mini App short name configured in @BotFather (the part after the bot username
# in t.me/<bot>/<app>). Public: used to build "Відкрити в Telegram" links.
NEXT_PUBLIC_TELEGRAM_MINI_APP_NAME=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL of this deployment (no trailing slash). Used for Open Graph
# tags and for building shareable/t.me links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Link to the official government information page. Shown on every results and
# location page next to the community-data disclaimer. Do not invent this value.
OFFICIAL_INFO_URL=

# ---------------------------------------------------------------------------
# Privacy policy (/privacy)
# ---------------------------------------------------------------------------
# Name of the data controller. Required in production: the production build
# fails if this is unset. In development an on-page "TODO" banner is shown instead.
PRIVACY_CONTROLLER_NAME=

# Contact email for privacy/data requests. Same production/development rule as above.
PRIVACY_CONTACT_EMAIL=

# ---------------------------------------------------------------------------
# Dev-only login (bypasses Telegram for local testing)
# ---------------------------------------------------------------------------
# Must be "true" AND NODE_ENV !== "production" for GET /api/auth/dev to work.
# Any other value, or a production build, makes that route return 404.
DEV_LOGIN_ENABLED=false
